<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Organizations</h2>
    <p>Explore organizations committed to promoting service and connecting volunteers with meaningful opportunities.</p>

    <section class="organization-grid">

        <div class="organization-card">
            <img src="/images/brightfuture-logo.png" alt="BrightFuture logo">
            <h2>BrightFuture</h2>
            <p>Supporting communities through meaningful service projects.</p>
        </div>

        <div class="organization-card">
            <img src="/images/greenharvest-logo.png" alt="GreenHarvest logo">
            <h2>GreenHarvest</h2>
            <p>Promoting environmental protection and sustainability.</p>
        </div>

        <div class="organization-card">
            <img src="/images/unityserve-logo.png" alt="UnityServe logo">
            <h2>UnityServe</h2>
            <p>Connecting people through community service.</p>
        </div>

    </section>
</main>

<%- include('partials/footer') %>
