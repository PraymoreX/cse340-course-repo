<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <% if (projectDetails) { %>
        <h2><%= projectDetails.title %></h2>

        <p><strong>Description:</strong> <%= projectDetails.description %></p>

        <p><strong>Date:</strong> <%= new Date(projectDetails.date).toLocaleDateString() %></p>

        <p><strong>Location:</strong> <%= projectDetails.location %></p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name %>
            </a>
        </p>
    <% } else { %>
        <h2>Project Not Found</h2>
        <p>The service project you requested does not exist.</p>
        <a href="/projects">Return to projects</a>
    <% } %>
</main>

<%- include('partials/footer') %>